# --- Required ---
# TCP port the Fastify server listens on
PORT=25596

# Telegram bot token from https://t.me/BotFather
TG_BOT_TOKEN='REPLACE_WITH_YOUR_BOT_TOKEN'

# Public base URL of this server (no trailing slash).
# The Telegram webhook is registered at ${SERVERURL}/telegram and must be public HTTPS.
SERVERURL='https://your-public-domain.example.com'

# Full JSON contents of a Google service account key file, inline on one line.
# Wrap in single quotes and keep the whole payload on a single line.
# Must include "client_email" and "private_key".
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"REPLACE_PROJECT_ID","private_key":"-----BEGIN PRIVATE KEY-----\nREPLACE_PRIVATE_KEY\n-----END PRIVATE KEY-----","client_email":"REPLACE@REPLACE.iam.gserviceaccount.com","client_id":"REPLACE_CLIENT_ID"}'

# --- Optional ---
# UTC offset in hours used to timestamp log output (default: 8 => UTC+8)
# timezone=8

# If set, forces the bot display name via setMyName (useful for testing). Omit in production.
# BOT_NAME_FOR_TEST="My Bot"

# JSON array of Telegram user IDs treated as global admins, e.g. '[123456789]'.
# GLOBAL_ADMIN_IDS='[123456789]'
